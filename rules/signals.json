{
  "_match_syntax": "Needles are matched per evidence pool (see analyzers/_match.py). Against symbols, ObjC classes and library names a needle must match the WHOLE name: 'connect' is the function connect, not dispatch_mach_connect; 'Security' is not libEndpointSecurity.dylib. Against strings a needle may match inside an entry, on identifier-token boundaries. A trailing '*' is a prefix match in both modes: 'posix_spawn*' matches posix_spawnattr_setflags.",
  "caller_validation": {
    "description": "Static indicators of caller/authorization validation, grouped into classes with their own weight. Presence is a FACT; absence is NOT a claim of missing authorization. Not part of the priority score.",
    "classes": {
      "audit-token-extraction": {
        "weight": 5,
        "description": "obtains the caller's audit token from the connection",
        "symbols": [
          "xpc_connection_get_audit_token",
          "xpc_dictionary_get_audit_token"
        ],
        "strings": [
          "auditToken"
        ]
      },
      "caller-identity": {
        "weight": 3,
        "description": "reads the caller's uid/gid/pid",
        "symbols": [
          "audit_token_to_euid",
          "audit_token_to_egid",
          "audit_token_to_ruid",
          "audit_token_to_rgid",
          "audit_token_to_pid",
          "audit_token_to_pidversion",
          "audit_token_to_asid",
          "audit_token_to_audit_session",
          "audit_token_to_posix_cred",
          "xpc_connection_get_euid",
          "xpc_connection_get_egid",
          "xpc_connection_get_pid"
        ]
      },
      "entitlement-check": {
        "weight": 5,
        "description": "checks an entitlement on the connection",
        "symbols": [
          "xpc_connection_copy_entitlement_value"
        ],
        "strings": [
          "valueForEntitlement"
        ]
      },
      "sectask-entitlement": {
        "weight": 8,
        "description": "builds a SecTask from the caller and queries its entitlements",
        "symbols": [
          "SecTaskCopyValueForEntitlement",
          "SecTaskCreateWithAuditToken",
          "SecTaskCopySigningIdentifier",
          "SecTaskCopyTeamIdentifier"
        ]
      },
      "code-signing-requirement": {
        "weight": 8,
        "description": "evaluates a code-signing requirement against the caller",
        "symbols": [
          "SecCodeCheckValidity",
          "SecStaticCodeCheckValidity",
          "SecRequirementCreateWithString",
          "SecCodeCopyGuestWithAttributes",
          "SecCodeCopySelf",
          "SecStaticCodeCreateWithPath"
        ],
        "strings": [
          "setCodeSigningRequirement"
        ]
      },
      "authorization-services": {
        "weight": 6,
        "description": "asks Authorization Services to authorize the right",
        "symbols": [
          "AuthorizationCopyRights",
          "AuthorizationCreate",
          "AuthorizationCreateFromExternalForm",
          "AuthorizationRightGet"
        ]
      },
      "sandbox-check": {
        "weight": 4,
        "description": "asks the sandbox whether the caller may do this",
        "symbols": [
          "sandbox_check",
          "sandbox_check_by_audit_token"
        ]
      },
      "code-signing-status": {
        "weight": 3,
        "description": "reads the caller's code-signing status flags",
        "symbols": [
          "csops",
          "csops_audittoken"
        ]
      }
    }
  },
