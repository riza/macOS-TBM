      "description": "runs as root / system service"
    },
    {
      "id": "exposes_ipc",
      "weight": 20,
      "description": "exposes a Mach / XPC service or socket"
    },
    {
      "id": "private_entitlement",
      "weight": 15,
      "description": "possesses private / high-value entitlements"
    },
    {
      "id": "auth_security_api",
      "weight": 15,
      "description": "uses authentication / Security.framework APIs"
    },
    {
      "id": "account_credential",
      "weight": 15,
      "description": "interacts with account / credential subsystems"
    },
    {
      "id": "filesystem_mutation",
      "weight": 10,
      "description": "filesystem mutation indicators"
    },
    {
      "id": "installer_update",
      "weight": 10,
      "description": "installer / software-update functionality"
    },
    {
      "id": "network",
      "weight": 10,
      "description": "network-facing surface"
    },
    {
      "id": "tcc_privacy",
      "weight": 15,
      "description": "TCC / privacy subsystem interaction"
    },
    {
      "id": "disabled_service",
      "weight": -30,
      "description": "job is disabled (launchd would not load it as configured)"
    }
